{
  "name": "recyconnect-backend",
  "version": "0.1.0",
  "private": true,
  "description": "RecyConnect Phase 1 backend: recyclable-waste traceability (API Gateway -> Lambda -> DynamoDB, S3 -> SQS -> worker)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker/classifier.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "tables": "tsx src/scripts/createTables.ts",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down",
    "local:bootstrap": "tsx src/scripts/bootstrapLocal.ts",
    "test:e2e": "node tests/e2e.mjs",
    "test:unit": "tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-sqs": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "serverless-http": "^4.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
